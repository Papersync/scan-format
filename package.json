{
  "name": "@papersync/scan-format",
  "version": "0.2.0",
  "description": "The shared Papersync scan file contract.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Papersync/scan-format.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "npm run build && c8 node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "zod": "4.6.7"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "unicode-segmenter": "0.17.3"
  },
  "homepage": "https://github.com/Papersync/scan-format#readme",
  "bugs": {
    "url": "https://github.com/Papersync/scan-format/issues"
  }
}
