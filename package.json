{
  "name": "@papersync/scan-format",
  "version": "0.1.0",
  "description": "Shared Papersync scan file validation, creation, pairing, and display helpers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": "github:papersync/scan-format",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && c8 node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "zod": "4.6.7",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.0.0",
    "c8": "^10.1.3"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts",
      "dist/**/*.js"
    ],
    "exclude": [],
    "reporter": [
      "text",
      "json-summary",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 100,
    "branches": 100,
    "functions": 100,
    "statements": 100,
    "src": [
      "src",
      "dist"
    ],
    "exclude-after-remap": true
  }
}
