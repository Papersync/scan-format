{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "sourceMap": false,
    "inlineSources": false,
    "lib": [
      "ES2022",
      "ES2022.Intl",
      "DOM"
    ],
    "types": [],
    "isolatedDeclarations": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
